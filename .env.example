# MongoDB Atlas (bepul M0 klaster yetadi)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/savdochi?retryWrites=true&w=majority

# Sessiya imzosi uchun kamida 32 belgili tasodifiy satr (masalan: openssl rand -base64 48)
AUTH_SECRET=

# Admin bo'ladigan mavjud hisoblar telefonlari, vergul bilan: +998901234567,+998935554433
ADMIN_PHONES=

# 1 bo'lsa — kirish sahifasida "Demo: do'kon / kompaniya" tugmalari chiqadi va namuna ma'lumotlar yaratiladi
DEMO_MODE=1

# Mahsulot rasmlari uchun Vercel Blob tokeni (Vercel → Storage → Blob → loyihaga ulash avtomatik qo'shadi)
BLOB_READ_WRITE_TOKEN=

# Saytning ochiq manzili (Telegram xabaridagi "Ochish" tugmasi uchun), masalan: https://savdochi.uz
APP_URL=

# Telegram bildirishnomalari (ixtiyoriy). @BotFather'da bot oching:
# TELEGRAM_BOT_TOKEN — bot tokeni, TELEGRAM_BOT_USERNAME — bot nomi (@ siz),
# TELEGRAM_WEBHOOK_SECRET — o'zingiz o'ylab topgan tasodifiy satr (A-Z, a-z, 0-9, _ -).
# Deploydan keyin Admin → "Telegram webhook'ni o'rnatish" tugmasini bir marta bosing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Kunlik qarz eslatmalari (Vercel Cron, vercel.json). Tasodifiy uzun satr kiriting —
# Vercel uni cron so'roviga avtomatik qo'shadi; bo'lmasa eslatmalar ishlamaydi.
CRON_SECRET=

# Payme sinov muhiti (test.paycom.uz). Haqiqiy to'lovlarda bo'sh qoldiring.
# Payme/Click merchant ma'lumotlarini har kompaniya o'zi Profil sahifasida kiritadi.
PAYME_TEST=
