# MongoDB Atlas (bepul M0 klaster yetadi)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/savdochi?retryWrites=true&w=majority

# Sessiya imzosi uchun kamida 32 belgili tasodifiy satr (masalan: openssl rand -base64 48)
AUTH_SECRET=

# Admin bo'ladigan mavjud hisoblar telefonlari, vergul bilan: +998901234567,+998935554433
ADMIN_PHONES=

# 1 bo'lsa — kirish sahifasida "Demo: do'kon / kompaniya" tugmalari chiqadi va namuna ma'lumotlar yaratiladi
DEMO_MODE=1

# Mahsulot rasmlari uchun Vercel Blob tokeni (Vercel → Storage → Blob → loyihaga ulash avtomatik qo'shadi)
BLOB_READ_WRITE_TOKEN=
